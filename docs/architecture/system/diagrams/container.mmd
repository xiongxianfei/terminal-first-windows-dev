C4Container
  Person(user, "Developer")
  System_Boundary(repo, "terminal-first-windows-dev repository") {
    Container(readme, "README", "Markdown", "Entry point, scope, warnings, guide index")
    Container(guides, "Numbered guides", "Markdown", "Layered setup instructions")
    Container(winScripts, "Windows helpers and doctors", "PowerShell", "Host checks and scoped Windows-side changes")
    Container(ubuntuScripts, "Ubuntu helpers and doctors", "Shell", "Ubuntu checks and scoped Linux-side changes")
    Container(configs, "Config examples", "Neovim/tmux config", "Shared source config and terminal tool settings")
    Container(specs, "Specs and tests", "Markdown", "Behavior contracts and validation mapping")
    Container(arch, "Architecture and ADRs", "Markdown/Mermaid", "Design boundaries and durable decisions")
  }
  System_Ext(windows, "Windows 11 host")
  System_Ext(ubuntu, "Ubuntu WSL2 distro")

  Rel(user, readme, "Starts")
  Rel(readme, guides, "Links")
  Rel(guides, winScripts, "May invoke")
  Rel(guides, ubuntuScripts, "May invoke")
  Rel(guides, configs, "Explains deployment")
  Rel(winScripts, windows, "Checks or changes scoped host state")
  Rel(ubuntuScripts, ubuntu, "Checks or changes scoped Ubuntu state")
  Rel(specs, guides, "Constrain observable behavior")
  Rel(arch, guides, "Constrains boundaries")
